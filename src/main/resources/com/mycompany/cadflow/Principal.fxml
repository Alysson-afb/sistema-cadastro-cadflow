                                          <Font size="36.0" />
                                       </font>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets top="10.0" />
                                 </padding>
                              </VBox>
                              <VBox alignment="TOP_CENTER" layoutX="470.0" layoutY="10.0" prefHeight="90.0" prefWidth="100.0" spacing="5.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 10;">
                                 <children>
                                    <Label text="Familiares" />
                                    <Label fx:id="lblNumFamiliares" text="0">
                                       <font>
                                          <Font size="36.0" />
                                       </font>
                                    </Label>
                                 </children>
                                 <padding>
                                    <Insets top="10.0" />
                                 </padding>
                              </VBox>
                              <VBox alignment="TOP_CENTER" layoutX="535.0" layoutY="10.0" prefHeight="90.0" prefWidth="100.0" spacing="5.0" style="-fx-background-color: #4CAF50; -fx-background-radius: 10;">
                                 <children>
                                    <Label text="Vagas disponíveis" />
