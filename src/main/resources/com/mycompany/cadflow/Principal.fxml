                                  <TableColumn fx:id="tableViewAcolhidosCodigo" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" resizable="false" style="text-align: center;" text="Código" />
                                  <TableColumn fx:id="tableViewAcolhidosNome" maxWidth="1.7976931348623157E308" minWidth="200.0" prefWidth="800.0" resizable="false" text="Nome" />
                                    <TableColumn fx:id="tableViewAcolhidosStatus" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" resizable="false" text="Acolhido?" />
                                </columns>
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" />
                                 </HBox.margin>
                              </TableView>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </content>
      </Tab>
      <Tab text="Visão Geral">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
